async function initCertificateGenerator() {
    const emps = await db.getAll('employees');
    const select = document.getElementById('cert-emp');
    select.innerHTML = '<option value="">-- Select Employee --</option>';
    emps.filter(e => e.status !== 'Unemployed').forEach(emp => { 
        select.innerHTML += `<option value="${emp.employeeId}">${emp.employeeName} (${emp.employeeId}) - ${emp.position}</option>`; 
    });
    
    document.getElementById('cert-date').valueAsDate = new Date();
    await generateNewReference();
    
    const settings = await db.get('settings', 'signatoryName');
    if (settings) document.getElementById('cert-signatory-name').value = settings.value;
    const titleSettings = await db.get('settings', 'signatoryTitle');
    if (titleSettings) document.getElementById('cert-signatory-title').value = titleSettings.value;
    
    updateCertPreview();
}

async function generateNewReference() {
    const now = new Date();
    const year = now.getFullYear();
    const month = now.getMonth() + 1;
    
    let counterSetting = await db.get('settings', 'certCounter');
    let counter = counterSetting ? counterSetting.value : 1;
    
    const ref = `Certificates/${year}/${month}/${String(counter).padStart(4, '0')}`;
    document.getElementById('cert-reference').value = ref;
}

