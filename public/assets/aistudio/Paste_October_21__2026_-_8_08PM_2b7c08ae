async function loadAttendanceSchedule() {
    const empFilter = document.getElementById('att-filter-emp').value;
    const monthFilter = document.getElementById('att-filter-month').value;
    
    const allAtt = await db.getAll('attendance');
    const allEmps = await db.getAll('employees');
    const empMap = {};
    allEmps.forEach(e => empMap[e.employeeId] = e);
    
    let filtered = allAtt;
    if (empFilter) filtered = filtered.filter(a => a.employeeId === empFilter);
    if (monthFilter) filtered = filtered.filter(a => a.date && a.date.startsWith(monthFilter));
    
    filtered.sort((a, b) => b.date.localeCompare(a.date));
    
    const tbody = document.getElementById('attendanceTableBody');
    tbody.innerHTML = '';
    
    let stats = { total: 0, present: 0, late: 0, absent: 0, extra: 0 };
    
    filtered.forEach(att => {
        const emp = empMap[att.employeeId];
        const empName = emp ? emp.employeeName : 'Unknown';
        const day = getDayOfWeek(att.date);
        
        stats.total++;
        if (att.status === 'Present') stats.present++;
        if (att.status === 'Late') stats.late++;
        if (att.status === 'Absent') stats.absent++;
