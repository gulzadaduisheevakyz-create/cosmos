async function deleteCurrentEmployee() {
    if (!currentDetailEmpId) return;
    const emp = await db.get('employees', currentDetailEmpId);
    if (!emp) return;
    if (confirm(`⚠️ WARNING: Are you sure you want to DELETE ${emp.employeeName} (${emp.employeeId})?\n\nThis will permanently remove their profile, attachments, and all associated payroll history. This action cannot be undone.`)) {
