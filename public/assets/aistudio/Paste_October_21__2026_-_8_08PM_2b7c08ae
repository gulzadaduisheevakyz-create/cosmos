async function openAddPayrollModal() {
    const month = prompt("Enter Payroll Month (e.g., October):"); if (!month) return;
    const year = prompt("Enter Payroll Year (e.g., 2026):", new Date().getFullYear().toString());
    const emp = await db.get('employees', currentDetailEmpId);
    const basic = parseFloat(emp.basicSalary) || 0;
    const allowances = (parseFloat(emp.foodAllowance)||0) + (parseFloat(emp.transportAllowance)||0) + (parseFloat(emp.carOperationAllowance)||0) + (parseFloat(emp.otherAllowance)||0) + (parseFloat(emp.limitedTransport)||0);
    const comm = calculateCommissions(emp);
    const commissions = comm.total;
    const deductions = parseFloat(emp.deductionCurrent) || 0;
    const payrollRecord = {
        id: `PAY-${emp.employeeId}-${year}-${month}`, employeeId: emp.employeeId, month: month, year: year,
        basicSalary: basic, allowances: allowances, commissions: commissions, deductions: deductions,
        netSalary: basic + allowances + commissions - deductions, paidAmount: 0, status: 'Draft', paymentDate: '', notes: 'Initial payroll generation',
        commissionBreakdown: { service: comm.service, product: comm.product, business: comm.business }
    };
    await db.save('payroll', payrollRecord);
    await db.logAudit('PAYROLL_CREATED', `Created draft payroll for ${emp.employeeName} for ${month} ${year}`);
    loadPayrollHistory(currentDetailEmpId);
    alert('Draft payroll created.');
}

async function deletePayroll(payrollId) {
    if (!confirm('Delete this payroll record?')) return;
    await db.delete('payroll', payrollId);
    await db.logAudit('PAYROLL_DELETED', `Deleted payroll record ${payrollId}`);
    loadPayrollHistory(currentDetailEmpId);
}

