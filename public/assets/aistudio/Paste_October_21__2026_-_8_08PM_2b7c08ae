async function exportToJSON() {
    const data = { 
        employees: await db.getAll('employees'), 
        payroll: await db.getAll('payroll'), 
        certificates: await db.getAll('certificates'),
        attendance: await db.getAll('attendance'),
        leaves: await db.getAll('leaves'),
        tickets: await db.getAll('tickets'),
        extraTime: await db.getAll('extraTime'),
        audit: await db.getAll('audit'), 
        exportDate: new Date().toISOString() 
    };
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = `Cosmos_HR_Full_Backup_${new Date().toISOString().slice(0,10)}.json`; a.click();
    URL.revokeObjectURL(url);
}

async function importFromJSON(input) {
    if (!input.files[0]) return;
    if (!confirm('WARNING: This will OVERWRITE all current data. Continue?')) { input.value = ''; return; }
    const reader = new FileReader();
    reader.onload = async (e) => {
        try {
            const data = JSON.parse(e.target.result);
            const empList = await db.getAll('employees'); for (const emp of empList) await db.delete('employees', emp.employeeId);
            for (const emp of data.employees) await db.save('employees', emp);
            for (const p of (data.payroll || [])) await db.save('payroll', p);
            for (const c of (data.certificates || [])) await db.save('certificates', c);
            for (const a of (data.attendance || [])) await db.save('attendance', a);
            for (const l of (data.leaves || [])) await db.save('leaves', l);
            for (const t of (data.tickets || [])) await db.save('tickets', t);
            for (const et of (data.extraTime || [])) await db.save('extraTime', et);
            alert('Database restored successfully!'); location.reload();
        } catch (err) { alert('Error restoring backup: ' + err.message); }
    };
    reader.readAsText(input.files[0]);
}

