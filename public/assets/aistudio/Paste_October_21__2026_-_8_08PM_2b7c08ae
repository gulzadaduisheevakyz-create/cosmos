async function exportLeaveToExcel() {
    const allEmps = await db.getAll('employees');
    const allLeaves = await db.getAll('leaves');
    
    const exportData = allEmps.filter(e => e.status !== 'Unemployed').map(emp => {
        const empLeaves = allLeaves.filter(l => l.employeeId === emp.employeeId);
        const entitlement = parseFloat(emp.leaveEntitlement) || 21;
        const taken = empLeaves.filter(l => l.status === 'Approved').reduce((sum, l) => sum + (parseFloat(l.days) || 0), 0);
        const pending = empLeaves.filter(l => l.status === 'Pending').reduce((sum, l) => sum + (parseFloat(l.days) || 0), 0);
        const remaining = entitlement - taken - pending;
        const basic = parseFloat(emp.basicSalary) || 0;
        const dailyRate = basic / 30;
        
        return {
            'Employee ID': emp.employeeId,
            'Name': emp.employeeName,
            'Joining Date': emp.joiningDate,
            'Entitlement': entitlement,
            'Taken': taken,
            'Pending': pending,
            'Remaining': remaining,
            'Daily Rate': dailyRate,
            'Leave Payment Value': remaining * dailyRate,
            'Next Ticket Date': emp.nextTicketDate || '',
            'Ticket Status': emp.ticketStatus || ''
        };
    });
    
    const ws = XLSX.utils.json_to_sheet(exportData);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, "Leave & Tickets");
    XLSX.writeFile(wb, `Cosmos_Leave_Tickets_${new Date().toISOString().slice(0,10)}.xlsx`);
}

// ==================== DEDUCTIONS TAB ====================
async function loadDeductionsTab() {
    if (!currentDetailEmpId) return;
    const emp = await db.get('employees', currentDetailEmpId);
    if (!emp) return;
    
    const current = parseFloat(emp.deductionCurrent) || 0;
    const outstanding = parseFloat(emp.outstanding) || 0;
    const futureDeductions = emp.futureDeductions || [];
    const futureTotal = futureDeductions.reduce((sum, d) => sum + (parseFloat(d.amount) || 0), 0);
    const remaining = outstanding - current;
    
    document.getElementById('ded-current').textContent = `QAR ${fmt(current)}`;
    document.getElementById('ded-outstanding').textContent = `QAR ${fmt(outstanding)}`;
    document.getElementById('ded-future-total').textContent = `QAR ${fmt(futureTotal)}`;
    document.getElementById('ded-remaining').textContent = `QAR ${fmt(remaining)}`;
    
    // Show/hide future deductions section
    const futureSection = document.getElementById('future-deductions-section');
    const noFuture = document.getElementById('no-future-deductions');
    if (futureDeductions.length > 0) {
        futureSection.style.display = 'block';
        noFuture.style.display = 'none';
        renderFutureDeductionsList('p', futureDeductions);
    } else {
        futureSection.style.display = 'none';
        noFuture.style.display = 'block';
    }
    
    // Deduction history from payroll
    const allPayrolls = await db.getAll('payroll');
    const empPayrolls = allPayrolls.filter(p => p.employeeId === currentDetailEmpId && p.deductions > 0);
    const dTbody = document.getElementById('deduction-history-body');
    dTbody.innerHTML = '';
    empPayrolls.sort((a, b) => `${b.year}-${b.month}`.localeCompare(`${a.year}-${a.month}`)).forEach(p => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td>${p.month} ${p.year}</td>
            <td class="num" style="color:var(--danger);">QAR ${fmt(p.deductions)}</td>
            <td>${p.notes || 'Payroll deduction'}</td>
            <td>Payroll</td>
            <td><span class="badge ${p.status === 'Paid' ? 'badge-green' : 'badge-yellow'}">${p.status}</span></td>
        `;
        dTbody.appendChild(tr);
    });
    if (empPayrolls.length === 0) dTbody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding: 20px;">No deduction history.</td></tr>';
}

