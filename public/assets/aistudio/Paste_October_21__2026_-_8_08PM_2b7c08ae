                const join = new Date(row["JOINING DATE"]);
                if (!isNaN(join)) {
                    join.setFullYear(join.getFullYear() + 2);
                    endContract = join.toISOString().split('T')[0];
                }
            }
            
            const payerBank = row["PAYER BANK"] || '';
            const payerBankShort = row["PAYER BANK SHORT"] || '';
            
