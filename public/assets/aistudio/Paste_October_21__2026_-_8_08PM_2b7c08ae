// ==================== COMMISSION CALCULATIONS ====================
function calculateCommissions(emp) {
    if (!emp) return { service: 0, product: 0, business: 0, total: 0 };
    
    const settings = {
        salesRate: 10,
        productRate: 5,
        businessTarget: 200000,
        businessRate: 5
    };
    
    // Service Sales Commission
    const salesTarget = parseFloat(emp.saleTargetRate) || 0;
    const actualSales = parseFloat(emp.totalSalesRate) || 0;
    const salesRate = parseFloat(emp.saleCommissionRate) || settings.salesRate;
    let serviceCommission = 0;
    let serviceEligible = false;
    if (salesTarget > 0 && actualSales >= salesTarget) {
        serviceCommission = actualSales * (salesRate / 100);
        serviceEligible = true;
    } else if (salesTarget === 0 && actualSales > 0) {
        serviceCommission = actualSales * (salesRate / 100);
        serviceEligible = true;
    }
    
    // Product Sales Commission
    const productSales = parseFloat(emp.prodTotalSales) || 0;
    const productRate = parseFloat(emp.prodSaleCommission) || settings.productRate;
    let productCommission = 0;
    let productEligible = false;
    if (productSales > 0) {
        productCommission = productSales * (productRate / 100);
        productEligible = true;
    }
    
    // Business Target Commission
    const businessGross = parseFloat(emp.businessGross) || 0;
    const businessTarget = settings.businessTarget;
    const businessRate = parseFloat(emp.businessTargetRate) || settings.businessRate;
    let businessCommission = 0;
    let businessEligible = false;
    if (businessGross >= businessTarget) {
        businessCommission = businessGross * (businessRate / 100);
        businessEligible = true;
    }
    
    return {
        service: serviceCommission,
        serviceEligible,
        serviceTarget: salesTarget,
        serviceActual: actualSales,
        serviceRate: salesRate,
        serviceAchievement: salesTarget > 0 ? (actualSales / salesTarget * 100) : 0,
        product: productCommission,
        productEligible,
        productSales,
        productRate,
        business: businessCommission,
        businessEligible,
        businessTarget,
        businessGross,
        businessRate,
        businessAchievement: businessTarget > 0 ? (businessGross / businessTarget * 100) : 0,
        total: serviceCommission + productCommission + businessCommission
    };
}

