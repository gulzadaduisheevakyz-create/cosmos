async function saveAttendanceEntry() {
    if (!currentDetailEmpId) return;
    const emp = await db.get('employees', currentDetailEmpId);
    if (!emp) return;
    
    const date = document.getElementById('att-date').value;
    const timeIn = document.getElementById('att-time-in').value;
    const timeOut = document.getElementById('att-time-out').value;
    const breakStart = document.getElementById('att-break-start').value;
    const breakEnd = document.getElementById('att-break-end').value;
    const schedStart = document.getElementById('att-sched-start').value;
    const schedEnd = document.getElementById('att-sched-end').value;
    const status = document.getElementById('att-status').value;
    const remarks = document.getElementById('att-remarks').value;
    
    if (!date) { alert('Please select a date.'); return; }
    
    // Check for duplicate
    const existingAttId = `ATT-${emp.employeeId}-${date}`;
    const existing = await db.get('attendance', existingAttId);
    if (existing) {
        if (!confirm('Attendance record already exists for this date. Overwrite?')) return;
    }
    
    // Calculate times
    let totalWorkMinutes = 0;
    let scheduledWorkMinutes = 0;
    let extraMinutes = 0;
    
    if (timeIn && timeOut) {
        const inMin = timeToMinutes(timeIn);
        const outMin = timeToMinutes(timeOut);
        let workMin = outMin - inMin;
        
        // Subtract break if applicable
        if (breakStart && breakEnd) {
            const breakMin = timeToMinutes(breakEnd) - timeToMinutes(breakStart);
            if (breakMin > 0) workMin -= breakMin;
        }
        
        // Handle overnight shifts
        if (workMin < 0) workMin += 24 * 60;
        
        totalWorkMinutes = Math.max(0, workMin);
    }
    
    if (schedStart && schedEnd) {
        scheduledWorkMinutes = timeToMinutes(schedEnd) - timeToMinutes(schedStart);
        // Subtract scheduled break
        if (breakStart && breakEnd) {
            const breakMin = timeToMinutes(breakEnd) - timeToMinutes(breakStart);
            if (breakMin > 0) scheduledWorkMinutes -= breakMin;
        }
    }
    
    extraMinutes = totalWorkMinutes - scheduledWorkMinutes;
    
    const attRecord = {
        attId: existingAttId,
        employeeId: emp.employeeId,
        employeeName: emp.employeeName,
        date: date,
        scheduledStart: schedStart,
        scheduledEnd: schedEnd,
        timeIn: timeIn,
        timeOut: timeOut,
        breakStart: breakStart,
        breakEnd: breakEnd,
        totalWorkMinutes: totalWorkMinutes,
        scheduledWorkMinutes: scheduledWorkMinutes,
        extraMinutes: extraMinutes,
        status: status,
        remarks: remarks,
        createdAt: new Date().toISOString(),
        createdBy: 'Admin'
    };
    
    await db.save('attendance', attRecord);
    
    // Update extra-time balance
    if (extraMinutes !== 0) {
        await updateExtraTimeBalance(emp.employeeId, extraMinutes, status === 'Present' || status === 'Late' ? 'Work' : 'Adjustment', 'Attendance entry');
    }
    
    await db.logAudit('ATTENDANCE_SAVED', `Saved attendance for ${emp.employeeName} on ${date}`);
    alert('✅ Attendance saved successfully.');
    closeModal('modal-attendance');
    loadAttendanceTab();
}

async function updateExtraTimeBalance(empId, minutes, type, reason) {
    const allExtra = await db.getAll('extraTime');
    const empExtra = allExtra.filter(e => e.employeeId === empId);
    
    let currentBalance = 0;
    let grossEarned = 0;
    let used = 0;
    
    empExtra.forEach(e => {
        if (e.type === 'Earned') { grossEarned += e.minutes; currentBalance += e.minutes; }
        else if (e.type === 'Used') { used += e.minutes; currentBalance -= e.minutes; }
    });
    
    const newRecord = {
        extraId: `ET-${empId}-${Date.now()}`,
        employeeId: empId,
        date: new Date().toISOString().split('T')[0],
        type: minutes > 0 ? 'Earned' : 'Used',
        minutes: Math.abs(minutes),
        reason: reason,
        balanceAfter: currentBalance + minutes,
        approvedBy: 'Admin',
        createdAt: new Date().toISOString()
    };
    
    await db.save('extraTime', newRecord);
}

