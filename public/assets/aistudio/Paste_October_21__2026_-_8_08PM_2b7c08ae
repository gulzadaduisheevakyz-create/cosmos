async function handleSpecificUpload(input, type) {
    if (!input.files || !input.files[0]) return;
    const file = input.files[0];
    if (file.size > 10 * 1024 * 1024) { alert('⚠️ File is too large. Please keep attachments under 10MB.'); input.value = ''; return; }
    const reader = new FileReader();
    reader.onload = async function(e) {
        const emp = await db.get('employees', currentDetailEmpId);
        if (!emp) return;
        if (type === 'image') { emp.imageData = e.target.result; emp.photoData = e.target.result; document.getElementById('detail-photo').src = e.target.result; }
        else if (type === 'passport') { emp.passportData = { name: file.name, data: e.target.result, date: new Date().toISOString() }; }
        else if (type === 'qid') { emp.qidData = { name: file.name, data: e.target.result, date: new Date().toISOString() }; }
        else if (type === 'employer') { emp.employerDocData = { name: file.name, data: e.target.result, date: new Date().toISOString() }; }
        await db.save('employees', emp);
        await db.logAudit('DOC_UPLOADED', `Uploaded ${type} attachment for ${emp.employeeName} (${emp.employeeId})`);
        loadDocuments(emp);
        alert(`✅ ${type.charAt(0).toUpperCase() + type.slice(1)} uploaded successfully.`);
        input.value = '';
    };
    reader.readAsDataURL(file);
}

function previewAttachment(type) {
    const emp = currentEmployees.find(e => e.employeeId === currentDetailEmpId);
    if (!emp) return;
    let data = null;
    if (type === 'image') data = emp.imageData || emp.photoData;
    else if (type === 'passport') data = emp.passportData ? emp.passportData.data : null;
    else if (type === 'qid') data = emp.qidData ? emp.qidData.data : null;
    else if (type === 'employer') data = emp.employerDocData ? emp.employerDocData.data : null;
    if (data) window.open(data, '_blank');
    else alert('No file uploaded to preview.');
}

async function deleteAttachment(type) {
    if (!confirm(`Are you sure you want to delete this ${type} attachment?`)) return;
    const emp = await db.get('employees', currentDetailEmpId);
    if (!emp) return;
    if (type === 'image') emp.imageData = null;
    else if (type === 'passport') emp.passportData = null;
    else if (type === 'qid') emp.qidData = null;
    else if (type === 'employer') emp.employerDocData = null;
    await db.save('employees', emp);
    await db.logAudit('DOC_DELETED', `Deleted ${type} attachment for ${emp.employeeName} (${emp.employeeId})`);
    loadDocuments(emp);
}

async function handlePhotoUpload(input) {
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = async function(e) {
            const emp = await db.get('employees', currentDetailEmpId);
