async function saveAndPrintCertificate() {
    const empId = document.getElementById('cert-emp').value;
    if (!empId) { alert('Please select an employee.'); return; }
    
    const emp = await db.get('employees', empId);
    if (!emp) { alert('Employee not found.'); return; }
    
    const certType = document.getElementById('cert-type').value;
    const recipient = getRecipient();
    const date = document.getElementById('cert-date').value;
    const reference = document.getElementById('cert-reference').value;
    const signatoryName = document.getElementById('cert-signatory-name').value;
    const signatoryTitle = document.getElementById('cert-signatory-title').value;
    
    if (!date) { alert('Please select a date.'); return; }
    
    const certData = {
        certId: `CERT-${Date.now()}`,
        certType: certType,
        certTypeName: certType === 'salary' ? 'Salary Certificate' : 'Certificate of Employment',
        employeeId: emp.employeeId,
        employeeName: emp.employeeName,
        employeePosition: emp.position,
        employeeQid: emp.residencyQid,
        employeeNationality: emp.nationality,
        employeeJoiningDate: emp.joiningDate,
        recipient: recipient,
        correspondingDate: date,
        reference: reference,
        signatoryName: signatoryName,
        signatoryTitle: signatoryTitle,
        salaryData: {
            basicSalary: emp.basicSalary,
            foodAllowance: emp.foodAllowance,
            transportAllowance: emp.transportAllowance,
            carOperationAllowance: emp.carOperationAllowance,
            otherAllowance: emp.otherAllowance,
            totalSalary: emp.totalSalary
        },
        includeBasic: document.getElementById('cert-include-basic').checked,
        includeFood: document.getElementById('cert-include-food').checked,
        includeTransport: document.getElementById('cert-include-transport').checked,
        includeCar: document.getElementById('cert-include-car').checked,
        includeOther: document.getElementById('cert-include-other').checked,
        createdAt: new Date().toISOString(),
        htmlContent: document.getElementById('cert-preview-content').innerHTML
    };
    
    await db.save('certificates', certData);
    await db.logAudit('CERTIFICATE_CREATED', `Created ${certData.certTypeName} for ${emp.employeeName} (${emp.employeeId}), Ref: ${reference}`);
    
    let counterSetting = await db.get('settings', 'certCounter');
    let counter = counterSetting ? counterSetting.value : 1;
    await db.save('settings', { key: 'certCounter', value: counter + 1 });
    
    renderPrintCertificate(certData);
    
    alert(`✅ Certificate saved to archive and ready to print!\n\nReference: ${reference}`);
    
    setTimeout(() => window.print(), 300);
    
    await generateNewReference();
}

