    const paidStatus = document.getElementById('leave-paid-status').value;
    const remarks = document.getElementById('leave-remarks').value;
    
    if (!startDate || !endDate) { alert('Please select start and end dates.'); return; }
    
    const start = new Date(startDate);
    const end = new Date(endDate);
    const days = Math.ceil((end - start) / (1000 * 60 * 60 * 24)) + 1;
    
    if (days <= 0) { alert('End date must be after start date.'); return; }
    
    const leaveRecord = {
        leaveId: `LEAVE-${emp.employeeId}-${Date.now()}`,
