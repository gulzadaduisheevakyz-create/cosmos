async function importFromExcel(input) {
    // FIXED: Ensure DB is ready before proceeding
    if (!db.ready) {
        document.getElementById('import-status').innerHTML = '<span style="color: var(--danger);">❌ Database not ready. Please wait for the system to fully load and try again.</span>';
        return;
    }
    
    const file = input.files[0];
    if (!file) return;
    document.getElementById('import-status').innerHTML = '<span style="color: var(--warning);"> Processing file...</span>';
    
    try {
        const data = await file.arrayBuffer();
        const workbook = XLSX.read(data, { type: 'array' });
        const jsonData = XLSX.utils.sheet_to_json(workbook.Sheets[workbook.SheetNames[0]], { defval: "" });
        let importedCount = 0, updatedCount = 0;
        
        for (const row of jsonData) {
            const empId = row["EMPLOYEE ID"] || `EMP-${Date.now()}`;
            const existing = await db.get('employees', empId);
            
            let passportDays = row["PASSPORT DAYS"] || '';
            if (row["PASSPORT EXPIRY"] && !passportDays) {
                const expiry = new Date(row["PASSPORT EXPIRY"]);
                if (!isNaN(expiry)) {
                    const diffDays = Math.ceil((expiry - new Date()) / (1000 * 60 * 60 * 24));
                    passportDays = `Day ${diffDays}`;
                }
            }
            
            let residencyDays = row["RESIDENCY DAYS"] || '';
            if (row["RESIDENCY EXPIRY"] && !residencyDays) {
                const expiry = new Date(row["RESIDENCY EXPIRY"]);
                if (!isNaN(expiry)) {
                    const diffDays = Math.ceil((expiry - new Date()) / (1000 * 60 * 60 * 24));
                    residencyDays = `Day ${diffDays}`;
                }
            }
            
            const basic = parseFloat(row["BASIC SALARY"]) || 0;
            const food = parseFloat(row["FOOD ALLOWANCE"]) || 0;
            const transport = parseFloat(row["TRANSPORTATION ALLOWANCE"]) || 0;
            const car = parseFloat(row["CAR OPERATION ALLOWANCE"]) || 0;
            const other = parseFloat(row["OTHER ALLOWANCE"]) || 0;
            const limited = parseFloat(row["LIMITED TRANSPORTATION"]) || 0;
