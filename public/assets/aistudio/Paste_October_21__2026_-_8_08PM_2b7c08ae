}

async function deleteArchiveCertificate(certId) {
    const cert = await db.get('certificates', certId);
    if (!cert) return;
    if (!confirm(`⚠️ Delete certificate "${cert.certTypeName}" for ${cert.employeeName}?\n\nReference: ${cert.reference}\n\nThis action cannot be undone.`)) return;
    if (!confirm(`Final confirmation: Delete this certificate permanently?`)) return;
    
    await db.delete('certificates', certId);
    await db.logAudit('CERTIFICATE_DELETED', `Deleted ${cert.certTypeName} for ${cert.employeeName}, Ref: ${cert.reference}`);
    alert('Certificate deleted from archive.');
    loadCertificateArchive();
}

async function exportArchiveToExcel() {
    const certs = await db.getAll('certificates');
    if (certs.length === 0) { alert('No certificates to export.'); return; }
    
    const exportData = certs.map(cert => ({
        'Reference': cert.reference,
        'Type': cert.certTypeName,
        'Employee ID': cert.employeeId,
        'Employee Name': cert.employeeName,
        'Position': cert.employeePosition,
        'QID': cert.employeeQid,
        'Nationality': cert.employeeNationality,
        'Joining Date': formatDate(cert.employeeJoiningDate),
        'Recipient': cert.recipient,
        'Corresponding Date': formatDate(cert.correspondingDate),
        'Signatory': cert.signatoryName,
        'Signatory Title': cert.signatoryTitle,
        'Basic Salary': cert.salaryData?.basicSalary || 0,
        'Food Allowance': cert.salaryData?.foodAllowance || 0,
        'Transport Allowance': cert.salaryData?.transportAllowance || 0,
        'Car Operation Allowance': cert.salaryData?.carOperationAllowance || 0,
        'Other Allowance': cert.salaryData?.otherAllowance || 0,
        'Total Salary': cert.salaryData?.totalSalary || 0,
        'Created At': new Date(cert.createdAt).toLocaleString()
    }));
    
    const ws = XLSX.utils.json_to_sheet(exportData);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, "Certificate Archive");
    XLSX.writeFile(wb, `Cosmos_Certificate_Archive_${new Date().toISOString().slice(0,10)}.xlsx`);
}

