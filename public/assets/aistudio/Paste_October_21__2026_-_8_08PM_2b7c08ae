function renderFutureDeductionsList(prefix, deductions) {
    const list = document.getElementById(`${prefix}-future-deductions-list`);
    list.innerHTML = '';
    deductions.forEach((d, idx) => {
        const item = document.createElement('div');
        item.className = 'deduction-item';
        item.innerHTML = `
            <div class="info" style="flex: 2;">
                <div style="font-weight: 600;">${formatDate(d.date)}</div>
                <div style="font-size: 12px; color: var(--text-muted);">${d.reason || 'No reason'}</div>
            </div>
            <div class="amount">QAR ${fmt(d.amount)}</div>
            <span class="badge ${d.status === 'Applied' ? 'badge-green' : d.status === 'Cancelled' ? 'badge-red' : 'badge-yellow'}">${d.status || 'Scheduled'}</span>
            <button type="button" class="btn btn-sm btn-danger" onclick="removeFutureDeduction('${prefix}', ${idx})">️</button>
        `;
        list.appendChild(item);
    });
}

function removeFutureDeduction(prefix, idx) {
    // This will be handled during save
    alert('Click "Save Changes" to apply this removal.');
}

function getFutureDeductionsFromForm(prefix) {
    const list = document.getElementById(`${prefix}-future-deductions-list`);
    const items = list.querySelectorAll('.deduction-item');
    const deductions = [];
    items.forEach(item => {
        const date = item.querySelector('.fd-date')?.value;
        const amount = parseFloat(item.querySelector('.fd-amount')?.value) || 0;
        const reason = item.querySelector('.fd-reason')?.value || '';
        if (date && amount > 0) {
            deductions.push({ date, amount, reason, status: 'Scheduled', id: `fd-${Date.now()}-${Math.random()}` });
        }
    });
    return deductions;
}

