async function generateMonthlyPayroll() {
    const month = document.getElementById('payroll-month-select').value;
    const year = document.getElementById('payroll-year-select').value;
    
    if (!month || !year) { alert('Please select both month and year.'); return; }

    const allEmps = await db.getAll('employees');
    const activeEmps = allEmps.filter(e => e.status !== 'Unemployed');
    
    if (activeEmps.length === 0) { alert('No active employees found.'); return; }

    if (!confirm(`⚠️ This will generate payroll records for ${activeEmps.length} active employees for ${month} ${year}.\n\nExisting records for this month will be skipped.\n\nContinue?`)) return;

    let created = 0, skipped = 0;

    for (const emp of activeEmps) {
        const payrollId = `PAY-${emp.employeeId}-${year}-${month}`;
        const existing = await db.get('payroll', payrollId);
        
        if (existing) { skipped++; continue; }

        const basic = parseFloat(emp.basicSalary) || 0;
        const allowances = (parseFloat(emp.foodAllowance)||0) + (parseFloat(emp.transportAllowance)||0) + (parseFloat(emp.carOperationAllowance)||0) + (parseFloat(emp.otherAllowance)||0) + (parseFloat(emp.limitedTransport)||0);
        
        // Calculate commissions using the new logic
        const comm = calculateCommissions(emp);
        const commissions = comm.total;
        
        // Calculate deductions - only current month, NOT future scheduled
        const deductions = parseFloat(emp.deductionCurrent) || 0;
        
        const netSalary = basic + allowances + commissions - deductions;

        const payrollRecord = {
            id: payrollId, employeeId: emp.employeeId, month: month, year: year,
            basicSalary: basic, allowances: allowances, commissions: commissions, deductions: deductions,
            netSalary: netSalary, paidAmount: 0, status: 'Draft', paymentDate: '', notes: `Auto-generated for ${month} ${year}`,
            commissionBreakdown: {
                service: comm.service,
                product: comm.product,
                business: comm.business
            }
        };

        await db.save('payroll', payrollRecord);
        created++;
    }

    await db.logAudit('PAYROLL_BATCH_GENERATED', `Generated payroll for ${month} ${year}: ${created} created, ${skipped} skipped`);
    alert(`✅ Payroll generation complete!\n\nCreated: ${created} records\nSkipped (already exists): ${skipped} records`);
    loadAllPayroll();
}

