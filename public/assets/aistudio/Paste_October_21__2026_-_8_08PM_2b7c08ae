function toggleEmployeeStatus() {
    if (!currentDetailEmpId) return;
    const emp = currentEmployees.find(e => e.employeeId === currentDetailEmpId);
    if (!emp) return;

    const modal = document.getElementById('modal-status-toggle');
    const title = document.getElementById('status-modal-title');
    const desc = document.getElementById('status-modal-desc');
    const unempFields = document.getElementById('status-modal-fields');
    const reactivateFields = document.getElementById('reactivate-fields');
    const confirmBtn = document.getElementById('status-modal-confirm');

    if (emp.status === 'Unemployed') {
        title.textContent = 'Reactivate Employee';
        desc.textContent = `This will move ${emp.employeeName} back to Active Employees. All historical records will be preserved.`;
        unempFields.style.display = 'none';
        reactivateFields.style.display = 'block';
        document.getElementById('reactivate-date').valueAsDate = new Date();
        document.getElementById('reactivate-position').value = '';
        confirmBtn.textContent = '✅ Reactivate Employee';
        confirmBtn.className = 'btn btn-success';
    } else {
        title.textContent = 'Move to Unemployed / Former Employee';
        desc.textContent = `This will move ${emp.employeeName} to the Unemployed / Former list. All historical payroll and document records will be preserved.`;
        unempFields.style.display = 'block';
        reactivateFields.style.display = 'none';
        document.getElementById('unemp-date').valueAsDate = new Date();
        confirmBtn.textContent = '⚠️ Confirm Move to Former';
        confirmBtn.className = 'btn btn-warning';
    }
    modal.style.display = 'flex';
}

function quickToggleStatus(empId) {
    currentDetailEmpId = empId;
    openEmployeeDetail(empId).then(() => { setTimeout(() => toggleEmployeeStatus(), 100); });
}

async function confirmStatusToggle() {
    if (!currentDetailEmpId) return;
    const emp = await db.get('employees', currentDetailEmpId);
    if (!emp) return;

    if (emp.status === 'Unemployed') {
        const rejoinDate = document.getElementById('reactivate-date').value;
        const newPosition = document.getElementById('reactivate-position').value;
        if (!rejoinDate) { alert('Please select a rejoining date.'); return; }
        emp.status = 'Active'; emp.rejoiningDate = rejoinDate;
        if (newPosition) emp.position = newPosition;
        delete emp.lastWorkingDate; delete emp.reasonForLeaving;
        await db.save('employees', emp);
        await db.logAudit('EMPLOYEE_REACTIVATED', `Reactivated ${emp.employeeName} (${emp.employeeId}) on ${rejoinDate}`);
        alert(`✅ ${emp.employeeName} has been reactivated as an Active Employee.`);
    } else {
        const lastDate = document.getElementById('unemp-date').value;
        const reason = document.getElementById('unemp-reason').value;
        if (!lastDate) { alert('Please select a last working date.'); return; }
        emp.status = 'Unemployed'; emp.lastWorkingDate = lastDate; emp.reasonForLeaving = reason;
        await db.save('employees', emp);
        await db.logAudit('EMPLOYEE_MOVED_TO_FORMER', `Moved ${emp.employeeName} (${emp.employeeId}) to Unemployed. Reason: ${reason}`);
        alert(`✅ ${emp.employeeName} has been moved to Unemployed / Former Employees.`);
    }
    closeModal('modal-status-toggle');
    openEmployeeDetail(currentDetailEmpId);
}

function closeModal(id) { document.getElementById(id).style.display = 'none'; }

async function loadPayrollHistory(empId) {
    const allPayrolls = await db.getAll('payroll');
    const empPayrolls = allPayrolls.filter(p => p.employeeId === empId).sort((a,b) => b.year.localeCompare(a.year) || b.month.localeCompare(a.month));
    const tbody = document.getElementById('payroll-history-body');
    tbody.innerHTML = '';
    empPayrolls.forEach(p => {
        const remaining = parseFloat(p.netSalary) - parseFloat(p.paidAmount);
        const tr = document.createElement('tr');
        tr.innerHTML = `<td>${p.month} ${p.year}</td><td class="num">${fmt(p.basicSalary)}</td><td class="num">${fmt(p.allowances)}</td><td class="num">${fmt(p.commissions)}</td>
            <td class="num" style="color:var(--danger);">${fmt(p.deductions)}</td><td class="num" style="font-weight:bold;">${fmt(p.netSalary)}</td>
            <td class="num">${fmt(p.paidAmount)}</td><td class="num" style="color:${remaining > 0 ? 'var(--danger)' : 'var(--success)'};">${fmt(remaining)}</td>
            <td><span class="badge ${p.status === 'Paid' ? 'badge-green' : 'badge-yellow'}">${p.status || 'Draft'}</span></td>
            <td><button class="btn btn-sm btn-danger" onclick="deletePayroll('${p.id}')">️</button></td>`;
