        remarks: remarks,
        requestedDate: new Date().toISOString(),
        approvedBy: null,
        approvedDate: null
    };
    
    await db.save('leaves', leaveRecord);
    await db.logAudit('LEAVE_REQUESTED', `${emp.employeeName} requested ${days} days of ${leaveType} from ${startDate} to ${endDate}`);
